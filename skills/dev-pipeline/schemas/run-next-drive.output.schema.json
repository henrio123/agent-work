{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run-next-drive output",
  "description": "Output schema for ./tools/run-next-drive.sh. Action is either drive_complete or drive_skipped.",
  "type": "object",
  "required": ["ok", "action", "picked"],
  "additionalProperties": false,
  "properties": {
    "ok": { "type": "boolean", "const": true },
    "action": {
      "type": "string",
      "enum": ["drive_complete", "drive_skipped"]
    },
    "picked": {
      "type": "object",
      "required": ["ok", "action"],
      "properties": {
        "ok": { "type": "boolean" },
        "action": { "type": "string" },
        "run_folder": { "type": "string" },
        "reason": { "type": "string" },
        "priority_bucket": { "type": "string" }
      },
      "additionalProperties": false
    },
    "autonomous": {
      "type": "object",
      "required": ["action", "final_action", "steps_run", "agent_calls", "artifacts_written", "artifacts_skipped", "trace"],
      "properties": {
        "action": { "type": "string" },
        "final_action": { "type": "string" },
        "steps_run": { "type": "number" },
        "agent_calls": { "type": "number" },
        "max_steps": { "type": "number" },
        "max_agent_calls": { "type": "number" },
        "artifacts_written": { "type": "array" },
        "artifacts_skipped": { "type": "array" },
        "trace": { "type": "array" },
        "retries_attempted": { "type": "number", "minimum": 0 },
        "patch_application": {
          "type": ["object", "null"],
          "properties": {
            "applied": { "type": "boolean" },
            "files_changed": { "type": "array", "items": { "type": "string" } },
            "error": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "test_execution": {
          "type": ["object", "null"],
          "properties": {
            "ok": { "type": "boolean" },
            "test_command": { "type": ["string", "null"] },
            "exit_code": { "type": ["number", "null"] },
            "stdout_tail": { "type": "string" },
            "stderr_tail": { "type": "string" },
            "duration_ms": { "type": "number", "minimum": 0 },
            "tests_discovered": { "type": "boolean" },
            "error": { "type": "string" }
          },
          "additionalProperties": false
        },
        "auto_commit": {
          "type": ["object", "null"],
          "properties": {
            "ok": { "type": "boolean" },
            "commit_sha": { "type": ["string", "null"] },
            "message": { "type": ["string", "null"] },
            "error": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
