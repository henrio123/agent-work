{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-state",
  "description": "Persistent state for an agent identity at agents/<agent_id>/state.json",
  "type": "object",
  "required": [
    "agent_id", "role", "current_task", "workload",
    "created_at", "updated_at", "last_active_at"
  ],
  "properties": {
    "agent_id":       { "type": "string", "minLength": 1 },
    "role":           { "type": "string", "minLength": 1 },
    "current_task":   { "type": ["string", "null"] },
    "workload": {
      "type": "object",
      "required": ["runs_started", "stages_completed"],
      "properties": {
        "runs_started":      { "type": "number", "minimum": 0 },
        "stages_completed":  { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "created_at":     { "type": "string" },
    "updated_at":     { "type": "string" },
    "last_active_at": { "type": "string" }
  },
  "additionalProperties": false
}
