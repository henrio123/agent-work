{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "apply-dev-patch output",
  "description": "Output of the apply-dev-patch tool",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": { "type": "boolean" },
    "action": {
      "type": "string",
      "enum": ["applied", "dry_run_passed"]
    },
    "error": { "type": "string" },
    "run_folder": { "type": "string" },
    "patch_path": { "type": "string" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dry_run": { "type": "boolean" }
  },
  "additionalProperties": false
}
