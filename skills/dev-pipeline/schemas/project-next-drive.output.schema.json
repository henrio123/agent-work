{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-next-drive output",
  "description": "Output schema for ./tools/project-next-drive.sh. Action is either drive_complete, drive_created_run, or drive_skipped.",
  "type": "object",
  "required": ["ok", "action", "picked"],
  "additionalProperties": false,
  "properties": {
    "ok": { "type": "boolean", "const": true },
    "action": {
      "type": "string",
      "enum": ["drive_complete", "drive_created_run", "drive_skipped"]
    },
    "picked": {
      "type": "object",
      "required": ["ok", "action"],
      "properties": {
        "ok": { "type": "boolean" },
        "action": { "type": "string" },
        "project_id": { "type": "string" },
        "task_id": { "type": "string" },
        "run_folder": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "priority_bucket": { "type": "string" },
        "recommended_agent": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "run_folder": { "type": "string" },
    "autonomous": {
      "type": "object",
      "required": ["action", "final_action", "steps_run", "agent_calls", "artifacts_written", "artifacts_skipped", "trace"],
      "properties": {
        "action": { "type": "string" },
        "final_action": { "type": "string" },
        "steps_run": { "type": "number" },
        "agent_calls": { "type": "number" },
        "max_steps": { "type": "number" },
        "max_agent_calls": { "type": "number" },
        "artifacts_written": { "type": "array" },
        "artifacts_skipped": { "type": "array" },
        "trace": { "type": "array" },
        "retries_attempted": { "type": "number", "minimum": 0 },
        "patch_application": {
          "type": ["object", "null"],
          "properties": {
            "applied": { "type": "boolean" },
            "files_changed": { "type": "array", "items": { "type": "string" } },
            "error": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "post_run": {
      "type": "object",
      "required": ["self_evaluation", "gaps_found"],
      "additionalProperties": false,
      "properties": {
        "self_evaluation": {
          "type": ["object", "null"],
          "properties": {
            "quality_score": { "type": ["number", "null"] },
            "deviations_count": { "type": "number", "minimum": 0 },
            "suggestions_count": { "type": "number", "minimum": 0 },
            "memory_written": { "type": "boolean" },
            "error": { "type": "string" }
          },
          "additionalProperties": false
        },
        "gaps_found": {
          "type": ["object", "null"],
          "properties": {
            "total_found": { "type": "number", "minimum": 0 },
            "auto_created_count": { "type": "number", "minimum": 0 },
            "error": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "graph_invalid": { "type": "boolean" }
  }
}
