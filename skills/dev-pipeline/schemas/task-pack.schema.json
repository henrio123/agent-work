{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-pack",
  "description": "A structured task pack generated for a backlog item. Stored in projects/<project_id>/task-packs/<task_id>.json",
  "type": "object",
  "required": [
    "task_id", "project_id", "title", "description", "owner_role",
    "inputs_present", "open_questions", "artifacts_expected",
    "acceptance_criteria", "constraints", "suggested_next_agents",
    "references", "created_at", "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "project_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "owner_role": { "type": "string" },
    "inputs_present": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts_expected": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_next_agents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
