{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-pack",
  "description": "A structured task pack generated for a backlog item. Stored in projects/<project_id>/task-packs/<task_id>.json",
  "type": "object",
  "required": [
    "task_id", "project_id", "title", "description", "owner_role",
    "inputs_present", "open_questions", "artifacts_expected",
    "acceptance_criteria", "constraints", "suggested_next_agents",
    "references", "created_at", "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "project_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "owner_role": { "type": "string" },
    "inputs_present": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts_expected": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_next_agents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "prior_knowledge": {
      "type": "object",
      "required": ["related_artifacts", "agent_memories", "related_findings"],
      "additionalProperties": false,
      "properties": {
        "related_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact_file", "run_id", "semantic_type", "relevance"],
            "additionalProperties": false,
            "properties": {
              "artifact_file": { "type": "string" },
              "run_id": { "type": "string" },
              "semantic_type": { "type": "string" },
              "relevance": { "type": "string" }
            }
          }
        },
        "agent_memories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["content", "type", "from_run"],
            "additionalProperties": false,
            "properties": {
              "content": { "type": "string" },
              "type": { "type": "string" },
              "from_run": { "type": "string" }
            }
          }
        },
        "related_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run_id", "conclusion", "hypothesis_count", "finding_count"],
            "additionalProperties": false,
            "properties": {
              "run_id": { "type": "string" },
              "conclusion": { "type": "string" },
              "hypothesis_count": { "type": "number" },
              "finding_count": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
