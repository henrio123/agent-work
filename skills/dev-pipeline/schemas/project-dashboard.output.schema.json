{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-dashboard output",
  "description": "Output schema for ./tools/project-dashboard.sh — aggregated project state for dashboards and automation.",
  "type": "object",
  "required": ["ok", "generated_at", "projects", "summary"],
  "additionalProperties": false,
  "properties": {
    "ok": { "type": "boolean", "const": true },
    "generated_at": { "type": "string" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_id", "title", "description", "totals", "backlog", "workload_by_agent"],
        "additionalProperties": false,
        "properties": {
          "project_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "totals": {
            "type": "object",
            "required": ["total", "todo", "in_progress", "blocked", "done"],
            "additionalProperties": false,
            "properties": {
              "total": { "type": "number" },
              "todo": { "type": "number" },
              "in_progress": { "type": "number" },
              "blocked": { "type": "number" },
              "done": { "type": "number" }
            }
          },
          "workload_by_agent": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["agent_id", "role", "runs_responsible", "stages_driven", "active_runs"],
              "additionalProperties": false,
              "properties": {
                "agent_id": { "type": "string" },
                "role": { "type": "string" },
                "runs_responsible": { "type": "number" },
                "stages_driven": { "type": "number" },
                "active_runs": { "type": "number" }
              }
            }
          },
          "backlog": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id", "type", "status", "priority", "owner_role",
                "depends_on", "parent_id", "tags", "run_folder",
                "priority_bucket", "run_stage", "run_blocked", "run_stop",
                "needs_task_pack", "needs_artifacts", "stalled"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "status": { "type": "string" },
                "priority": { "type": "string" },
                "owner_role": { "type": "string" },
                "depends_on": { "type": "array", "items": { "type": "string" } },
                "parent_id": { "type": ["string", "null"] },
                "tags": { "type": "array", "items": { "type": "string" } },
                "run_folder": { "type": ["string", "null"] },
                "priority_bucket": { "type": ["string", "null"] },
                "run_stage": { "type": ["string", "null"] },
                "run_blocked": { "type": "boolean" },
                "run_stop": { "type": "boolean" },
                "needs_task_pack": { "type": "boolean" },
                "needs_artifacts": { "type": "boolean" },
                "stalled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["projects", "tasks_total", "todo", "in_progress", "blocked", "done", "stopped", "stalled", "needs_task_pack", "needs_artifacts", "workload_summary"],
      "additionalProperties": false,
      "properties": {
        "projects": { "type": "number" },
        "tasks_total": { "type": "number" },
        "todo": { "type": "number" },
        "in_progress": { "type": "number" },
        "blocked": { "type": "number" },
        "done": { "type": "number" },
        "stopped": { "type": "number" },
        "stalled": { "type": "number" },
        "needs_task_pack": { "type": "number" },
        "needs_artifacts": { "type": "number" },
        "workload_summary": {
          "type": "object",
          "required": ["runs_per_role", "stages_per_role"],
          "additionalProperties": false,
          "properties": {
            "runs_per_role": { "type": "object", "additionalProperties": { "type": "number" } },
            "stages_per_role": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        }
      }
    }
  }
}
