{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev Notes",
  "type": "object",
  "required": ["ticket_id", "files_changed", "summary"],
  "properties": {
    "ticket_id": { "type": "string" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
