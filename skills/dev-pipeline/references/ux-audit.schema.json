{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UX Audit",
  "description": "Schema for 15-ux-audit.json — optional UX audit artifact (capability-provided, not a core stage).",
  "type": "object",
  "required": ["ticket_id", "flow_name", "routes_audited", "findings", "summary"],
  "properties": {
    "ticket_id": { "type": "string" },
    "flow_name": { "type": "string" },
    "routes_audited": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "route", "severity", "category", "description", "evidence", "recommendation"],
        "properties": {
          "id": { "type": "string" },
          "route": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommendation": { "type": "string" },
          "impact": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "competitor_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "object",
      "required": ["total_findings", "by_severity"],
      "properties": {
        "total_findings": { "type": "number" },
        "by_severity": {
          "type": "object",
          "required": ["critical", "high", "medium", "low"],
          "properties": {
            "critical": { "type": "number" },
            "high": { "type": "number" },
            "medium": { "type": "number" },
            "low": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
