# Workspace root used by every dev-pipeline tool.
# If unset, the code falls back to ~/dev/agent-work.
WORKSPACE_ROOT=~/dev/agent-work

# Optional: set to 1 to enable append-only JSONL audit logging
# inside each run folder (autonomous-audit.jsonl). Equivalent to
# passing --audit_log on the drive/run-next commands.
# DP_AUDIT_LOG=1

# Optional drive-loop tuning (tools/project-drive-loop.sh).
# Each can also be overridden via CLI flags --sleep / --max / --project.
# LOOP_SLEEP_SECONDS=5
# LOOP_MAX_ITERATIONS=100
# LOOP_PROJECT_ID=
